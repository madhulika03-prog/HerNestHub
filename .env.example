# Copy this to .env.local and fill values locally (DO NOT commit service role key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FUNCTIONS_BASE_URL=  # e.g. https://<project>.functions.supabase.co

# Notes:
# - SUPABASE_SERVICE_ROLE_KEY must never be exposed in frontend code or committed to source control.
# - For local testing of Edge Functions with the supabase CLI, the functions base URL is typically https://localhost:54321
